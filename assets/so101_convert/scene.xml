<mujoco model="so101_pick_place">
  <!-- Keep in the same folder as so101.xml so meshdir="meshes" resolves -->
  <include file="so101.xml"/>

  <worldbody>
    <!-- White work table; top surface stays at z=0 to match the robot and task coordinates. -->
    <body name="table" pos="0 0 0">
      <geom name="table_top" type="box" size="0.40 0.30 0.025" pos="0 0 -0.025"
            rgba="0.68 0.90 0.62 1" contype="1" conaffinity="1" condim="3"/>
      <geom name="table_leg_fl" type="box" size="0.025 0.025 0.325" pos="-0.35 -0.25 -0.375" rgba="0.45 0.27 0.14 1"/>
      <geom name="table_leg_fr" type="box" size="0.025 0.025 0.325" pos="0.35 -0.25 -0.375" rgba="0.45 0.27 0.14 1"/>
      <geom name="table_leg_bl" type="box" size="0.025 0.025 0.325" pos="-0.35 0.25 -0.375" rgba="0.45 0.27 0.14 1"/>
      <geom name="table_leg_br" type="box" size="0.025 0.025 0.325" pos="0.35 0.25 -0.375" rgba="0.45 0.27 0.14 1"/>
    </body>

    <!-- Cube to pick: 2 cm edge, 20 g, at (0.20, 0.00) -->
    <body name="cube" pos="0.20 0 0.01">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.01 0.01 0.01" mass="0.02"
            rgba="0.9 0.2 0.2 1" contype="1" conaffinity="1"
            condim="4" friction="1.2 0.02 0.002" solref="0.002 1"/>
    </body>

    <!-- Open-top box, centre (0.20, 0.12), inner 8x8 cm, walls 3 cm high, 5 mm thick -->
    <body name="box" pos="0.20 0.12 0">
      <geom name="box_floor" type="box" size="0.045 0.045 0.0025" pos="0 0 0.0025" rgba="0.2 0.4 0.9 1"/>
      <geom name="box_wall_px" type="box" size="0.0025 0.045 0.015" pos=" 0.0425 0 0.015" rgba="0.2 0.4 0.9 1"/>
      <geom name="box_wall_nx" type="box" size="0.0025 0.045 0.015" pos="-0.0425 0 0.015" rgba="0.2 0.4 0.9 1"/>
      <geom name="box_wall_py" type="box" size="0.045 0.0025 0.015" pos="0  0.0425 0.015" rgba="0.2 0.4 0.9 1"/>
      <geom name="box_wall_ny" type="box" size="0.045 0.0025 0.015" pos="0 -0.0425 0.015" rgba="0.2 0.4 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
